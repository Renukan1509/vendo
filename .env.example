# Vendogo Environment Configuration Template
# Duplicate this file to .env.local for local development

# Security & Authentication
JWT_SECRET=vendogo-production-secret-key-smart-vending-2026-secure

# App Domain URL (Used for QR code deep-links)
NEXT_PUBLIC_APP_URL=https://vendogo.vercel.app

# Database Options
# Out-of-the-box, Vendogo includes a persistent file-backed JSON/SQLite database engine in /data.
# When deploying to production on Vercel with Supabase / Neon / PostgreSQL:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
